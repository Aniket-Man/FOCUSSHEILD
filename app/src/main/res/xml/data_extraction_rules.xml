<?xml version="1.0" encoding="utf-8"?><!--
   FocusShield data extraction rules.

   FocusShield must never restore its own state from Auto Backup or device transfer.
   The previous (empty template) version excluded nothing, so Android restored
   shared_prefs/focus_shield_sync_prefs.xml on a fresh install — including
   `onboarding_completed = true` — and FocusNavGraph then resolved its start
   destination to Home, skipping onboarding entirely.

   Active session state (focus_active_session_prefs.xml) and per-install cloud
   sync bookkeeping (focus_shield_cloud_state.xml) are also excluded from both
   cloud backup and device-to-device transfer so sensitive session and account
   synchronization state never transfers unintentionally between installations
   or devices.

   The Room database is excluded as well: session/limit/blocker state must
   never be restored over a fresh install (cloud sync has its own guarded
   restore path). Main DB plus its WAL/SHM sidecars are all excluded so a
   partial restore cannot resurrect torn state (issue #14).

   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="focus_shield_sync_prefs.xml" />
        <exclude domain="sharedpref" path="focus_active_session_prefs.xml" />
        <exclude domain="sharedpref" path="focus_shield_cloud_state.xml" />
        <exclude domain="file" path="datastore" />
        <exclude domain="database" path="focus_shield_database" />
        <exclude domain="database" path="focus_shield_database-wal" />
        <exclude domain="database" path="focus_shield_database-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="focus_shield_sync_prefs.xml" />
        <exclude domain="sharedpref" path="focus_active_session_prefs.xml" />
        <exclude domain="sharedpref" path="focus_shield_cloud_state.xml" />
        <exclude domain="file" path="datastore" />
        <exclude domain="database" path="focus_shield_database" />
        <exclude domain="database" path="focus_shield_database-wal" />
        <exclude domain="database" path="focus_shield_database-shm" />
    </device-transfer>
</data-extraction-rules>
