<?xml version="1.0" encoding="utf-8"?><!--
   FocusShield backup rules (API 30 and below; ignored on API 31+).

   Same reasoning as data_extraction_rules.xml: the onboarding flag and the
   app's DataStore must not come back from a backup, or a fresh install lands
   on Home instead of the onboarding flow.

   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="focus_shield_sync_prefs.xml" />
    <exclude domain="file" path="datastore" />
</full-backup-content>
