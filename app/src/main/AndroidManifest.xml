<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Scheduled sessions are armed with an exact alarm so a session starts at the configured
        minute. SCHEDULE_EXACT_ALARM is user-grantable and revocable on Android 12+, and is denied
        by default on Android 14+ for apps the user has not granted it to, so the app:
          * checks AlarmManager.canScheduleExactAlarms() before every exact request
            (FocusScheduleAlarmScheduler),
          * falls back to an inexact setAndAllowWhileIdle alarm instead of failing silently,
          * tells the user when that fallback is in force, and re-arms on the
            ACTION_SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED broadcast.
        USE_EXACT_ALARM is deliberately NOT requested: it is reserved for alarm-clock/calendar apps
        whose core function is an alarm, would bypass the user's choice, and is a Play policy risk
        for a study tool. See docs/SCHEDULED_SESSIONS.md.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        Both foreground-service types are declared because they are used on different API levels —
        see the service declaration below and ForegroundServiceTypes.kt. Android requires the type
        passed to startForeground() to be a subset of the types declared here, so declaring only one
        of them makes startForeground() throw on the other half of the install base.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
        Self-update only: the user downloads a newer FocusShield APK and hands it to the system
        installer. Nothing is installed silently — the OS always shows its own confirmation, and
        Play Protect / unknown-source restrictions are never bypassed (prompt.txt §9, §10, §21).
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".FocusShieldApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.blocker.BlockOverlayActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:theme="@style/Theme.BlockOverlay" />

        <!--
            Deliberately a plain `standard` activity WITHOUT singleInstance/noHistory.

            With singleInstance + noHistory, the instance from the first block stayed as a
            finishing root of its own task. When the allowance timer later expired and
            AppLimitManager relaunched the overlay with CLEAR_TOP|SINGLE_TOP, Android handed the
            intent back to that dying record instead of creating a new instance and silently
            dropped the launch — so the "time's up" popup never came back after the user chose
            "use for N minutes". A fresh instance per launch is what makes it reappear.
        -->
        <activity
            android:name=".feature.applimits.ui.AppLimitOverlayActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.TransparentOverlay" />

        <!--
            Focus-session foreground service.

            foregroundServiceType declarations and the type passed to startForeground() must match
            exactly, per Android's "the requested type must be a subset of the declared types" rule:

              * Android 14+ (API 34+) → specialUse. A study timer that keeps enforcing an app/website
                block while the screen is off has no OS-provided category; specialUse with the
                PROPERTY_SPECIAL_USE_FGS_SUBTYPE justification string below is the documented route
                (and the one Google Play reviews). REQUIRES the FOREGROUND_SERVICE_SPECIAL_USE
                permission, declared above.
              * Android 10–13 (API 29–33) → dataSync. These releases have no specialUse type at all,
                and startForeground(type=…) rejects any bit that is not declared in the manifest — so
                declaring only specialUse crashes startForeground with IllegalArgumentException on
                every Android 10–13 device, which is why both are declared and both permissions are
                held. REQUIRES the FOREGROUND_SERVICE_DATA_SYNC permission, declared above.
              * Android 9 and below → no type parameter (the two-argument startForeground).

            The runtime side of this contract lives in ForegroundServiceTypes (selection + declared-
            mask validation) and FocusSessionForegroundService.startForegroundWithProperType().
            Do not change one without the other. See docs/FOREGROUND_SERVICE.md.
        -->
        <service
            android:name=".feature.session.service.FocusSessionForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus session study timer and background app blocker" />
        </service>

        <service
            android:name=".core.accessibility.FocusAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:stopWithTask="false"
            android:directBootAware="true"
            android:label="@string/accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".core.notification.FocusNotificationListenerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true"
            android:label="FocusShield Notification Interceptor">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".feature.session.notification.StudyPlanReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.focusshield.ACTION_STUDY_PLAN_REMINDER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".feature.session.notification.FocusScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.focusshield.ACTION_FOCUS_SCHEDULE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".feature.session.notification.BootAndDailyResetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <!--
                    Fired by the platform when the user grants or revokes "Alarms & reminders".
                    Re-arming here is what turns a granted exact-alarm permission into exact alarms
                    without waiting for a reboot: without it, schedules armed while the permission was
                    missing would stay inexact until the next boot.
                -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <action android:name="com.example.focusshield.ACTION_DAILY_RESET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.receiver.FocusDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_sample" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".feature.widgets.FocusShieldFocusWidgetReceiver"
            android:exported="false"
            android:label="@string/focus_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_widget_info" />
        </receiver>

        <receiver
            android:name=".feature.widgets.FocusShieldUsageWidgetReceiver"
            android:exported="false"
            android:label="@string/usage_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_info" />
        </receiver>

        <receiver
            android:name=".feature.widgets.FocusShieldUnlockWidgetReceiver"
            android:exported="false"
            android:label="@string/unlock_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/unlock_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
