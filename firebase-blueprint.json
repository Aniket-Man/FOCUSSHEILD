{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile settings, study preferences, and streak statistics.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The owner's Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address."
        },
        "dailyStudyGoalMinutes": {
          "type": "integer",
          "description": "Target daily study time in minutes."
        },
        "currentStreak": {
          "type": "integer",
          "description": "Current consecutive days study streak."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile last update timestamp."
        }
      },
      "required": ["userId", "displayName", "dailyStudyGoalMinutes", "currentStreak", "createdAt", "updatedAt"]
    },
    "FocusSession": {
      "title": "FocusSession",
      "description": "A completed focus or study session synced to the user's cloud history.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique session identifier."
        },
        "userId": {
          "type": "string",
          "description": "The owner's Firebase Auth UID."
        },
        "mode": {
          "type": "string",
          "description": "Session mode (e.g., POMODORO, DEEP_FOCUS, STOPWATCH)."
        },
        "durationMinutes": {
          "type": "integer",
          "description": "Completed focus duration in minutes."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the session was completed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record creation timestamp."
        },
        "subject": {
          "type": "string",
          "description": "Subject studied during this session."
        },
        "topic": {
          "type": "string",
          "description": "Specific topic studied."
        },
        "goal": {
          "type": "string",
          "description": "Target goal for this session."
        },
        "actualDurationMillis": {
          "type": "integer",
          "description": "Verified study duration in milliseconds."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the session completed its planned duration."
        }
      },
      "required": ["id", "userId", "mode", "durationMinutes", "completedAt", "createdAt"]
    },
    "StudyPlan": {
      "title": "StudyPlan",
      "description": "A scheduled study task or planner item belonging to a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique study plan identifier."
        },
        "userId": {
          "type": "string",
          "description": "The owner's Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "description": "Title of the study task."
        },
        "subject": {
          "type": "string",
          "description": "Subject or category name."
        },
        "targetMinutes": {
          "type": "integer",
          "description": "Planned duration in minutes."
        },
        "isCompleted": {
          "type": "boolean",
          "description": "Whether the planned task is completed."
        },
        "scheduledDate": {
          "type": "string",
          "description": "ISO date string for the scheduled study day."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["id", "userId", "title", "targetMinutes", "isCompleted", "scheduledDate", "createdAt", "updatedAt"]
    },
    "SessionQuote": {
      "title": "SessionQuote",
      "description": "A live-writing motivational/study quote displayed on the Session Summary screen and managed via an external Admin Website.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique quote document identifier (e.g., quote_01)."
        },
        "text": {
          "type": "string",
          "description": "The quote body text that animates live on the Session Summary screen."
        },
        "author": {
          "type": "string",
          "description": "Author or source attribution for the quote."
        },
        "category": {
          "type": "string",
          "description": "Optional theme tag (e.g., Deep Work, Discipline, Perseverance)."
        },
        "fontStyle": {
          "type": "string",
          "description": "Typography style key: 'editorial' (Playfair Display), 'calligraphy' (Cormorant Garamond), or 'classic' (Cinzel)."
        },
        "active": {
          "type": "boolean",
          "description": "Whether this quote is active in the Session Summary rotation."
        },
        "typingSpeedMs": {
          "type": "integer",
          "description": "Live-writing speed in milliseconds per character (e.g., 28-40)."
        },
        "createdAt": {
          "type": "integer",
          "description": "Creation epoch timestamp in milliseconds."
        },
        "updatedAt": {
          "type": "integer",
          "description": "Last update epoch timestamp in milliseconds."
        }
      },
      "required": ["id", "text", "author", "active", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile document keyed by Firebase Auth UID."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/FocusSession"
      },
      "description": "Completed focus sessions belonging to the user."
    },
    "/users/{userId}/study_plans/{planId}": {
      "schema": {
        "$ref": "#/entities/StudyPlan"
      },
      "description": "Study planner tasks belonging to the user."
    },
    "/session_quotes/{quoteId}": {
      "schema": {
        "$ref": "#/entities/SessionQuote"
      },
      "description": "Global collection of live-writing Session Summary quotes preloaded by the app and editable from the external Admin Website."
    }
  }
}
