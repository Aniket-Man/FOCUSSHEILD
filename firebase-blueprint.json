{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Profile data and synced avatar for an authenticated user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The Firebase Auth UID of the user" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "email": { "type": "string", "description": "Email address of the user" },
        "photoBase64": { "type": "string", "description": "Compressed Base64 avatar data" },
        "dailyStudyGoalMinutes": { "type": "integer", "description": "Daily study goal in minutes" },
        "currentStreak": { "type": "integer", "description": "Current consecutive active study days" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp; clients must pass serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp; clients must pass serverTimestamp" }
      },
      "required": ["userId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "SessionRecord": {
      "title": "Session Record",
      "description": "Historical study session record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique session identifier" },
        "userId": { "type": "string", "description": "The Firebase Auth UID of the user" },
        "mode": { "type": "string", "description": "Session mode like POMODORO, STOPWATCH, or TIMER" },
        "durationMinutes": { "type": "integer", "description": "Duration completed in minutes" },
        "completedAt": { "type": "string", "format": "date-time", "description": "When session completed" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp record was created" }
      },
      "required": ["id", "userId", "mode", "durationMinutes", "completedAt", "createdAt"]
    },
    "StudyPlanRecord": {
      "title": "Study Plan Record",
      "description": "User customized study plan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique plan identifier" },
        "userId": { "type": "string", "description": "The Firebase Auth UID of the user" },
        "title": { "type": "string", "description": "Plan title or description" },
        "targetSubject": { "type": "string", "description": "Associated subject name" },
        "durationMinutes": { "type": "integer", "description": "Target duration in minutes" },
        "activeDays": { "type": "array", "description": "Days of week when plan is active" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["id", "userId", "title", "targetSubject", "durationMinutes", "createdAt", "updatedAt"]
    },
    "AppLimitRecord": {
      "title": "App Limit Record",
      "description": "Usage limit configured for an application",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique limit identifier" },
        "userId": { "type": "string", "description": "The Firebase Auth UID of the user" },
        "packageName": { "type": "string", "description": "Android application package name" },
        "appName": { "type": "string", "description": "Human-readable application name" },
        "dailyLimitMinutes": { "type": "integer", "description": "Allowed minutes per day" },
        "isStrict": { "type": "boolean", "description": "Whether strict mode blocking is enabled" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["id", "userId", "packageName", "appName", "dailyLimitMinutes", "isStrict", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Root user profile document"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/SessionRecord" },
      "description": "User study sessions subcollection"
    },
    "/users/{userId}/study_plans/{planId}": {
      "schema": { "$ref": "#/entities/StudyPlanRecord" },
      "description": "User study plans subcollection"
    },
    "/users/{userId}/app_limits/{limitId}": {
      "schema": { "$ref": "#/entities/AppLimitRecord" },
      "description": "User app limits subcollection"
    }
  }
}
