# Supabase Cloud Sync (Optional - leave empty for offline mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# In-app updater (Optional).
# The updater reads GitHub Releases unauthenticated. GitHub answers 404 to `releases/latest` for a
# PRIVATE repository, so while that is the case the app reports "no published release" instead of
# inventing one — no GitHub token may ship inside the APK.
# To make update checks work today, point UPDATE_FEED_URL at any URL that serves the release JSON
# (a small backend, a Supabase Edge Function, or a static file). Accepted shapes:
#   GitHub-style:  {"tag_name":"v1.3.1","body":"...","assets":[{"name":"FocusShield.apk",...}]}
#   normalised:    {"versionName":"1.3.1","apkUrl":"https://...","releaseNotes":"...",
#                   "releasePageUrl":"https://..."}
# Leave empty to use the GitHub API directly (works once the repository is public).
UPDATE_FEED_URL=

# Optional: owner/repo of the release feed, for forks. Defaults to Aniket-Man/FOCUSSHEILD.
UPDATE_REPO_SLUG=
